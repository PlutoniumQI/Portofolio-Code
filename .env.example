# Next.js frontend (Vercel)
#
# Local development points at the Laravel backend on 127.0.0.1:8000.
# Production values are documented in docs/deploy-render-neon.md.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=id

# Used by client components (contact form, language switcher, etc.).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Used by server components / route handlers. Never expose secrets with NEXT_PUBLIC_.
API_URL=http://127.0.0.1:8000

# Shared secret for POST /api/revalidate (phase 2). Generate a long random value.
REVALIDATE_SECRET=
