# Standard Laravel Settings
APP_NAME="Laravel Vercel Application"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_YOUR_OWN_APP_KEY_AND_PASTE_HERE
APP_URL=https://your-app-domain.vercel.app

# Vercel Read-Only Disk Cache Overrides
# Redirecting compiler, package, configuration, and event caches to the writable /tmp directory.
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
VIEW_COMPILED_PATH=/tmp

# Serverless Session & Cache Drivers
SESSION_DRIVER=cookie
CACHE_STORE=array
CACHE_DRIVER=array
LOG_CHANNEL=stderr

# TiDB Serverless MySQL Connection
DB_CONNECTION=mysql
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com # Replace with your TiDB host from TiDB Console
DB_PORT=4000 # TiDB uses port 4000 by default
DB_DATABASE=your_database_name
DB_USERNAME=your_username.root
DB_PASSWORD=your_tidb_password

# SSL Configuration for TiDB Serverless
# TiDB Serverless strictly requires SSL.
# Vercel containers run on Amazon Linux/Debian. You can point to the standard CA path:
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Supabase S3-Compatible Storage Configuration
# For local dev, keep PUBLIC_DISK_DRIVER=local. For production Vercel dev, set PUBLIC_DISK_DRIVER=s3.
PUBLIC_DISK_DRIVER=local
PUBLIC_DISK_URL=http://127.0.0.1:8000/storage

SUPABASE_ACCESS_KEY_ID=your_supabase_s3_access_key_id
SUPABASE_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key
SUPABASE_DEFAULT_REGION=us-east-1 # e.g. ap-southeast-1, us-east-1, etc.
SUPABASE_BUCKET=your_supabase_storage_bucket_name
SUPABASE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_USE_PATH_STYLE_ENDPOINT=true
SUPABASE_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public/your_supabase_storage_bucket_name

