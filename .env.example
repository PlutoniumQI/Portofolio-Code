# Next.js frontend (Vercel)
#
# Local development points at the Laravel backend on 127.0.0.1:8000.
# Production values are documented in docs/deploy-vercel-neon.md.

# Public site URL. Baked into the build for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side API base URL. Used by server components, the /api/messages proxy, and ISR.
# Never put secrets in NEXT_PUBLIC_ variables.
API_URL=http://127.0.0.1:8000

# Shared secret for POST /api/revalidate. Must equal FRONTEND_REVALIDATE_SECRET in the Laravel backend.
# Generate a long random value; leave empty locally if you are not testing the webhook.
FRONTEND_REVALIDATE_SECRET=

# ISR window in seconds before a stale page is refreshed in the background.
PORTFOLIO_REVALIDATE_SECONDS=300
