# Production environment for the Laravel backend on Vercel Containers + Neon.
#
# This file is a reference template. Set these in Vercel -> Project -> Settings
# -> Environment Variables. Do not commit a filled-in copy. See
# docs/deploy-vercel-neon.md for the full runbook.

APP_NAME="re:SKY API"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Set this to https://api.your-domain.com (no trailing slash).
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Vercel captures stdout/stderr in Runtime Logs. Do not write logs to the
# ephemeral container filesystem in production.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Neon Postgres. Use the direct (non-pooler) connection string. Pick a Neon
# region close to the Function region (sin1 for Singapore).
# URL-encode special characters in the password.
DB_CONNECTION=pgsql
DB_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DB_SSLMODE=require

# Functions are stateless and can run concurrently, so sessions and cache must
# be shared. The queue stays synchronous: there is no background worker.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Media is URL-only: paste public image and PDF URLs in the admin.
FILESYSTEM_DISK=public
MAIL_MAILER=log

# Seeded once from a workstation with `php artisan migrate --seed --force`.
# These values are only used when the admin user is first created.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Frontend (Vercel). CORS accepts only these exact origins.
FRONTEND_URL=https://www.your-domain.com
FRONTEND_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
FRONTEND_ALLOW_VERCEL_PREVIEWS=false
FRONTEND_REVALIDATE_URL=https://www.your-domain.com/api/revalidate
FRONTEND_REVALIDATE_SECRET=

# Vercel injects PORT (default 80); the image's Caddyfile reads it. Do not
# override it in the dashboard.
#
# There are no RUN_MIGRATIONS or SEED_DATABASE flags: migrations and seeding
# are a one-off step from a workstation, never a container startup task.
