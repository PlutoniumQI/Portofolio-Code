# Build context is backend/. Vercel builds the image from Dockerfile.vercel;
# keep the context small and free of secrets.

.git
.gitignore
.env
.env.*

node_modules
vendor
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache

# Local package/service manifests include dev-only providers such as
# laravel/pail, which is not installed with --no-dev.
bootstrap/cache

database/*.sqlite
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/*.sqlite

public/storage
public/fonts-manifest.dev.json
public/hot

*.md
.DS_Store
