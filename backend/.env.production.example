# Production environment for the Laravel backend on Apply.Build + Neon.
#
# This file is a reference template. Apply.Build injects these values as real
# environment variables; do not commit a filled-in copy. See
# docs/deploy-apply-build-neon.md for the full runbook.

APP_NAME="re:SKY API"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Set this to https://api.your-domain.com (no trailing slash).
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Apply.Build captures stderr in its log stream. Do not write logs to the
# ephemeral container filesystem in production.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Neon Postgres. Prefer the direct (non-pooler) connection string for Laravel,
# ideally in an EU region so it is close to the Apply.Build app.
# URL-encode special characters in the password.
DB_CONNECTION=pgsql
DB_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DB_SSLMODE=require

# Sessions, cache, and queue all use the Postgres database. A single web
# container does not drain a database queue, so keep the queue synchronous.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Media is URL-only: paste public image and PDF URLs in the admin. No upload
# storage, GitHub token, or upload cap is required.
FILESYSTEM_DISK=public
MAIL_MAILER=log

# First deploy only: RUN_MIGRATIONS=true, SEED_DATABASE=true.
# Set SEED_DATABASE=false after the admin user and placeholder content exist,
# otherwise every restart re-runs the seeders and overwrites your edits.
RUN_MIGRATIONS=true
SEED_DATABASE=false
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Frontend (Vercel). CORS accepts only these exact origins.
FRONTEND_URL=https://your-domain.com
FRONTEND_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
FRONTEND_ALLOW_VERCEL_PREVIEWS=false
FRONTEND_REVALIDATE_URL=https://your-domain.com/api/revalidate
FRONTEND_REVALIDATE_SECRET=

# Apply.Build routes to the port configured in the app settings; the image
# listens on 8080. TLS is terminated by Apply.Build's edge.
NGINX_HTTP_PORT=8080
SSL_MODE=off
HEALTHCHECK_PATH=/up

# Keep the PHP-FPM pool inside the free 512 MiB instance.
PHP_OPCACHE_ENABLE=1
PHP_MEMORY_LIMIT=192M
PHP_FPM_PM_CONTROL=dynamic
PHP_FPM_PM_MAX_CHILDREN=3
PHP_FPM_PM_START_SERVERS=1
PHP_FPM_PM_MIN_SPARE_SERVERS=1
PHP_FPM_PM_MAX_SPARE_SERVERS=2
