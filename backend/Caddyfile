:{$PORT:80} {
	root * /app/public
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# The admin stylesheet, admin script, and vendored SortableJS build are
	# static and deployed with the image, so cache them aggressively. Without
	# this, Vercel treats every asset request as a Function invocation.
	@adminAssets path /admin.css /admin.js /vendor/*
	header @adminAssets Cache-Control "public, max-age=3600"

	php_server {
		try_files {path} index.php
	}
}
