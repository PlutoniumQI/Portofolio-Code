# Production environment for the Laravel backend on Render + Neon.
#
# This file is a reference template. Render injects these values as real
# environment variables; do not commit a filled-in copy. See
# docs/deploy-render-neon.md for the full runbook.

APP_NAME="re:SKY API"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Set this to https://api.your-domain.com (no trailing slash).
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Render captures stderr in its log stream. Do not write logs to the
# ephemeral container filesystem in production.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Neon Postgres. Prefer the direct (non-pooler) connection string for Laravel.
# URL-encode special characters in the password.
DB_CONNECTION=pgsql
DB_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DB_SSLMODE=require

# Sessions, cache, and queue all use the Postgres database. Render Free runs a
# single web process, so the database queue is not drained; use sync.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Legacy uploads use the public disk during the migration. The Render disk is
# ephemeral; phase 2 uploads images to the GITHUB assets repository instead.
FILESYSTEM_DISK=public
MAIL_MAILER=log

# First deploy only: RUN_MIGRATIONS=true, SEED_DATABASE=true.
# Set SEED_DATABASE=false after the admin user and placeholder content exist.
RUN_MIGRATIONS=true
SEED_DATABASE=false
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# GitHub assets repository and fine-grained token (Contents: Read and write).
GITHUB_TOKEN=
GITHUB_ASSETS_OWNER=
GITHUB_ASSETS_REPO=
GITHUB_ASSETS_BRANCH=main
GITHUB_ASSETS_PATH=portfolio

# Frontend (Vercel). CORS accepts only these exact origins.
FRONTEND_URL=https://your-domain.com
FRONTEND_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
FRONTEND_ALLOW_VERCEL_PREVIEWS=false
FRONTEND_REVALIDATE_URL=https://your-domain.com/api/revalidate
FRONTEND_REVALIDATE_SECRET=

# Upload limits. Keep PORTFOLIO_MAX_UPLOAD_KB at or below PHP's upload limit.
PORTFOLIO_MAX_UPLOAD_KB=10240
PHP_UPLOAD_MAX_FILE_SIZE=10M
PHP_POST_MAX_SIZE=12M
PHP_OPCACHE_ENABLE=1

# serversideup/php: Render routes traffic to port 10000, but nginx defaults to
# 8080. SSL is terminated by Render's proxy.
NGINX_HTTP_PORT=10000
SSL_MODE=off
HEALTHCHECK_PATH=/up
